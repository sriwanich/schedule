##############################################
# RDSIS - Rayong Disaster Statistics System
# Environment Configuration
##############################################

APP_NAME="ระบบสถิติสาธารณภัยจังหวัดระยอง"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://schedule.dpmpry.online
APP_KEY=base64:GENERATE_32_CHAR_RANDOM_STRING_HERE
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=th

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=dpmpryg_sriwanich
DB_USERNAME=dpmpry_schedule
DB_PASSWORD=M@t34a053896077
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Cache Driver: file | apcu | redis
CACHE_DRIVER=file
CACHE_TTL=3600
CACHE_PREFIX=rdsis_

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=7200
SESSION_SECURE=true
SESSION_HTTPONLY=true

# Mail (SMTP for Plesk)
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=MAIL_PASSWORD_HERE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="ระบบ RDSIS"

# Storage Paths
STORAGE_PATH=storage
LOG_PATH=storage/logs
EXPORT_PATH=storage/exports
UPLOAD_PATH=public/uploads

# Logging
LOG_LEVEL=warning
LOG_MAX_FILES=30

# Security
BCRYPT_ROUNDS=12
JWT_SECRET=GENERATE_SECRET_HERE
CSRF_TOKEN_TTL=3600

# API Rate Limiting
API_RATE_LIMIT=100
API_RATE_WINDOW=3600

# Export Settings
EXPORT_ROWS_LIMIT=50000
REPORT_LOGO_PATH=public/assets/images/logo.png


